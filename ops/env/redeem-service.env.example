# Install as /etc/bitcoinbride/redeem-service.env with mode 0600.
NODE_ENV=production

# Required only by bitcoinbride-redeem-relayer.service.
# Also required by the public testnet API and worker when they create deposit intents,
# request Chainlink authorizations, mint, and complete redeems.
RELAYER_PRIVATE_KEY=

# Required by the public testnet API and worker when public-testnet config uses rpcUserEnv/rpcPasswordEnv.
BITCOIN_RPC_USER=
BITCOIN_RPC_PASSWORD=

# Required only by bitcoinbride-redeem-attester-local.service.
# Local/testnet only. Production should ingest external ReleaseAttestationV1 artifacts instead.
DON_PRIVATE_KEYS=

# Required only when don-release-adapter config uses signerAddressesEnv.
# Comma-separated configured DON signer addresses, not private keys.
DON_SIGNER_ADDRESSES=

# Optional for bitcoinbride-don-release-adapter.service.
BITCOINBRIDE_ADAPTER_HOST=127.0.0.1
BITCOINBRIDE_ADAPTER_PORT=8790

# Required by ops/docker/compose.sepolia-signet-chainlink.example.yml Caddy service.
# Point this DNS name at the host before starting Caddy.
BITCOINBRIDE_ADAPTER_DOMAIN=adapter.example.com
BITCOINBRIDE_PUBLIC_API_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com

# Required only when running the local BTC PSBT signer CLI.
# Regtest/testnet only unless backed by an approved custody policy.
BTC_SIGNER_WIF=
