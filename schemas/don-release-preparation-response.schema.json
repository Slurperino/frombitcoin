{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bitcoinbride.local/schemas/don-release-preparation-response.schema.json",
  "title": "DonReleasePreparationResponseV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "spendPlan",
    "bitcoinTxHex"
  ],
  "properties": {
    "kind": {
      "const": "DonReleasePreparationResponseV1"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "destinationAddress": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "spendPlan": {
      "$ref": "https://bitcoinbride.local/schemas/normalized-spend-plan.schema.json"
    },
    "bitcoinTxHex": {
      "$ref": "#/$defs/nonEmptyHex"
    },
    "custodyReceipt": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "nonEmptyHex": {
      "type": "string",
      "pattern": "^(?:[a-fA-F0-9]{2})+$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    }
  }
}
