{
  "serviceName": "bitcoinbride-redeem-attester-local-testnet",
  "database": "/var/lib/bitcoinbride/redeems.sqlite",
  "pollIntervalMs": 12000,
  "health": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 8788
  },
  "watcher": {
    "enabled": false
  },
  "attester": {
    "enabled": true,
    "donPrivateKeysEnv": "DON_PRIVATE_KEYS",
    "threshold": 2,
    "limit": 100
  },
  "relayer": {
    "enabled": false
  }
}
