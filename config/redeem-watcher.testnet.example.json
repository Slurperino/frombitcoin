{
  "serviceName": "bitcoinbride-redeem-watcher-testnet",
  "database": "/var/lib/bitcoinbride/redeems.sqlite",
  "pollIntervalMs": 12000,
  "health": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 8787
  },
  "watcher": {
    "enabled": true,
    "rpcUrl": "https://replace-with-evm-testnet-rpc",
    "burnGateway": "0x0000000000000000000000000000000000000000",
