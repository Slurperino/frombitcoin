    "sign:release-psbt": "node scripts/sign-release-psbt.js",
    "health:public-testnet": "node scripts/public-testnet-healthcheck.js",
    "reconcile:public-testnet": "node scripts/public-testnet-reconcile.js",
    "backup:public-testnet": "node scripts/backup-public-testnet-db.js",
