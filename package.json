{
  "name": "bitcoinbride",
  "version": "0.1.0",
  "private": true,
  "description": "BTC <-> EVM bridge prototype with DON-gated state transitions",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "node scripts/compile.js",
    "test": "node --test --test-concurrency=1",
    "deploy": "node scripts/deploy.js",
    "validate:authorization": "node scripts/validate-authorization.js",
    "watch:redeems": "node scripts/watch-redeems.js",
    "attest:redeems": "node scripts/attest-redeems.js",
    "ingest:attestation": "node scripts/ingest-attestation.js",
    "verify:don-release": "node scripts/verify-don-release.js",
    "configure:chainlink-functions": "node scripts/configure-chainlink-functions.js",
    "request:chainlink-mint": "node scripts/request-chainlink-mint.js",
    "request:chainlink-release": "node scripts/request-chainlink-release.js",
    "encode:chainlink-attestation": "node scripts/encode-chainlink-attestation.js",
    "fetch:redeem-event": "node scripts/fetch-redeem-event.js",
    "relay:redeems": "node scripts/relay-redeems.js",
    "build:bitcoin-psbt": "node scripts/build-bitcoin-psbt.js",
    "broadcast:bitcoin-tx": "node scripts/broadcast-bitcoin-tx.js",
    "regtest:bitcoin-release": "node scripts/run-bitcoin-regtest-release.js",
    "service:don-release-adapter": "node scripts/don-release-adapter.js",
