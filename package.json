    "audit:prod": "node scripts/audit-production.js",
    "audit:all": "npm audit"
  },
  "dependencies": {
    "ajv": "^8.18.0",
    "bitcoinjs-lib": "^7.0.1",
    "commander": "14.0.3",
    "ecpair": "^3.0.1",
    "ethers": "6.16.0",
    "tiny-secp256k1": "^2.2.4"
  },
  "devDependencies": {
    "ganache": "7.9.2",
    "solc": "0.8.20"
